# Copie para .env e preencha. Nunca faça commit do .env.
# O servidor valida tudo ao iniciar e mostra o que estiver faltando.

# --- Servidor ---------------------------------------------------------------
NODE_ENV=development              # development | test | production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info                    # fatal | error | warn | info | debug | trace

# --- Banco (Supabase) -------------------------------------------------------
# Supabase > Connect > "Session pooler" (porta 5432). Use o modo sessão, não o de transação.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Opcional, recomendado em produção: conteúdo PEM do certificado CA do Supabase
# (Database Settings > SSL Configuration > Download certificate). Com ele o certificado é verificado.
# DATABASE_SSL_CA=
DATABASE_POOL_MAX=10

# --- Meta / WhatsApp Cloud API ----------------------------------------------
# Painel do app na Meta > Configurações do app > Básico > "Chave secreta do aplicativo".
# É com ela que validamos a assinatura X-Hub-Signature-256 de cada webhook.
META_APP_SECRET=
# Texto que VOCÊ inventa e cola no painel da Meta ao configurar o webhook (16+ caracteres).
# Gere com: openssl rand -hex 24
META_VERIFY_TOKEN=
# Versão da Graph API. Use a mais recente mostrada no painel do app (WhatsApp > Configuração da API).
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# --- Segurança --------------------------------------------------------------
# Chave que criptografa os tokens da Meta de cada clínica no banco.
# Gere com: openssl rand -base64 32   (se trocar, recadastre as clínicas)
ENCRYPTION_KEY=

# --- Fila e processamento ---------------------------------------------------
WORKER_CONCURRENCY=4              # conversas processadas em paralelo
WORKER_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5                # tentativas antes de desistir de um processamento
JOB_LOCK_TIMEOUT_MS=120000        # job "rodando" há mais que isso é considerado travado e volta à fila
MESSAGE_DEBOUNCE_MS=4000          # espera após a última mensagem para juntar mensagens seguidas
MESSAGE_DEBOUNCE_MAX_MS=15000     # espera máxima, contada da primeira mensagem do lote
INBOUND_MAX_AGE_MS=86400000       # mensagens mais antigas que isso são gravadas, mas não respondidas

# --- Tokens da Meta por clínica (só para o comando clinic:upsert) -----------
# O arquivo clinics/<clinica>.yaml diz o NOME da variável; o valor fica só aqui.
# EXEMPLO_FISIO_WHATSAPP_TOKEN=
